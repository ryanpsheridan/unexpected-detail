---
/*
  The unexpected detail wordmark: the staggered two line lockup, flush right,
  with "unexpected" stepped in from the edge. Markup only; the brand book's
  global styles draw it, and every setting comes from the nearest ancestor
  through custom properties, so a section can pin its own font or dot:

    --ud-display, --wm-scale, --wm-lh, --wm-track   typeface (data-font)
    --dd, --dl, --db                               period geometry
    --isplit                                       where the i's dot ends
    --pd-display, --i-top                          dot mode (data-dot)

  Both dots are drawn in every mode and switched by those properties, so a
  toggle never reflows the lockup: the period hangs past the edge and the i
  keeps its own glyph, only recolored above its stem.
*/
interface Props {
  /** Font size before the typeface's scale, in any CSS length (cqi in tiles). */
  size?: string;
  /** Lowercase centered single line, for tight horizontal spaces. */
  line?: boolean;
  /**
   * The primary logo: the falling line set in the open space beside
   * "detail", from the left edge of "unexpected" to just short of the d.
   * Styles in src/styles/wordmark.css.
   */
  lines?: boolean;
  /** Strokes in the row. Small sizes (the nav) use half, so the row stays open. */
  count?: number;
  class?: string;
  style?: string;
}
const { size = "12cqi", line = false, lines = false, count = 34, class: cls, style = "" } = Astro.props;
// The primary logo's row: 34 strokes with the 23rd fallen, as drawn; the
// fallen one keeps its place (about two thirds along) at any count.
const LINE_COUNT = count;
const LINE_FALL = Math.round((count - 1) * (22 / 33));
---

<span
  class:list={["wm", { "wm--line": line, "wm--lined": lines && !line }, cls]}
  style={`font-size:calc(var(--wm-scale, 1) * ${size});${style}`}
  role="img"
  aria-label="unexpected detail"
><span class="wm-a" aria-hidden="true">unexpected</span>{
    lines && !line ? (
      <span class="wm-b" aria-hidden="true">
        <span class="wm-lines">
          {Array.from({ length: LINE_COUNT }, (_, i) => (
            <span class:list={{ "wm-fall": i === LINE_FALL }} style={`--x:${(i / (LINE_COUNT - 1)).toFixed(4)}`} />
          ))}
        </span>
        <span class="wm-word">deta<span class="wm-i">i</span>l<span class="wm-pd">.</span></span>
      </span>
    ) : (
      <span class="wm-b" aria-hidden="true">deta<span class="wm-i">i</span>l<span class="wm-pd">.</span></span>
    )
  }</span>
