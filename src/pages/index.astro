---
/*
  Home, round three: the podcast's public site for future listeners, ahead
  of the December 2026 launch (PRODUCT.md). In the concept page's system,
  on the type scale in src/styles/site.css.

  The story, top to bottom:
  1. Dark. The falling line, full width, rises as a waveform, settles, and
     one line tips over; "Curiosity flips the frame." rises in beneath it.
     From the first bit of scrolling, "flips" turns over like a card and the
     page turns light with it. Nothing pins.
  2. "A podcast built around what rarely makes the final edit." arrives
     word by word, a rule draws across beneath it, and the note settles
     under its right end. Then the page moves on.
  3. After a breath: Smart. Warm. A little offbeat. holds on the left
     while the four traits pass on the right.
  4. A floating dark panel (after berryreader.com) that opens to full width
     and stays open: Marcy, and the side conversations, lit word by word
     with the scroll (after simplysheetdesign.com).
  5. The handoff: a line the reader draws with their own scroll.
  6. Episodes: the heading holds while placeholder episodes pass.
  7. The page flips back to dark: Everyone has one. What's yours?

  No gold text. Butter is the dot on dark; Mustard (#B8890F, 3:1 on
  paper) is the dot and the graphic accent on light.
*/
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/wordmark.css";
import "../styles/site.css";

// The opening's falling line, full width: 49 strokes, a little closer
// than round one's, the 33rd falls. Every other one drops out on phones;
// the fallen one is odd, so it stays.
const heroLines = 49;
const heroFall = 32;

// "flips" is a two-sided card that turns over as the page scrolls.
const heroLine = "Curiosity flips the frame.";

// The second section's line arrives word by word with the scroll.
const frameWords = "A podcast built around what rarely makes the final edit.".split(" ");

const traits = [
  { t: "Smart and substantial", b: "Real ideas and opinions, worth thinking about afterward." },
  { t: "Genuinely curious", b: "Interested in people, not their titles." },
  { t: "Playful and a little eccentric", b: "Witty, expressive, and happy to follow a tangent." },
  { t: "Warm and easy", b: "Comfortable and spontaneous. Never intimidating." },
];

const handoff = [
  { k: "The last guest", b: "leaves a question for someone they have never met." },
  { k: "This episode", b: "opens with it. The new guest answers, then leaves one of their own." },
  { k: "The next guest", b: "hears it for the first time, on the mic." },
];

// Placeholders until Riverside publishes real episodes. Each row will open
// its own page at /episodes/NN; those pages don't exist yet.
const episodes = [
  { n: "01", title: "The first conversation", guest: "Guest to be announced", when: "December 2026" },
  ...Array.from({ length: 8 }, (_, i) => ({
    n: String(i + 2).padStart(2, "0"),
    title: "Episode title to come",
    guest: "Guest to be announced",
    when: "2027",
  })),
];
---

<Layout
  title="unexpected detail, a podcast hosted by Marcy"
  description="A podcast built around what rarely makes the final edit. Hosted by Marcy. First episode December 2026."
>
  <main id="main" class="site home">
    <!-- 1. Opening: the line, then the headline; as the page scrolls away,
         "flips" turns over, and the page turns light with it -->
    <section class="hero" id="hero" aria-labelledby="hero-h">
      <div class="hero-in">
        <div class="wrap">
          <div class="hero-col">
            <div class="hero-lines" aria-hidden="true">
              {
                Array.from({ length: heroLines }, (_, i) => (
                  <span class:list={{ fall: i === heroFall }} style={`--x:${(i / (heroLines - 1)).toFixed(4)}`} />
                ))
              }
            </div>
            <h1 id="hero-h" class="t-h1 hero-h" aria-label={heroLine}>
              <span aria-hidden="true">Curiosity <span class="flipword"><span class="ff ff-front">flips</span><span class="ff ff-back">flips</span></span> the frame.</span>
            </h1>
            <!-- A placeholder: it goes nowhere until the first episode is out. -->
            <button class="go hero-go" type="button">Hear the first episode <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. What the show is: the words arrive, a rule draws, the note settles -->
    <section class="frame" id="frame" aria-labelledby="frame-h">
      <div class="stage">
        <div class="wrap frame-grid">
          <h2 id="frame-h" class="t-h1 frame-h" aria-label={frameWords.join(" ")} style={`--n:${frameWords.length}`}>
            {
              frameWords.map((w, i) => (
                <span class="w" style={`--i:${i}`} aria-hidden="true">
                  {w}
                </span>
              ))
            }
          </h2>
          <span class="frame-rule" aria-hidden="true"></span>
          <p class="t-l frame-note">
            We know what people do, what they’ve won, and what they’re supposed to sell next. This show is
            about everything else: the detours, the half-formed ideas, the quiet obsessions.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. The energy: after a breath, the heading holds while traits pass -->
    <section class="energy" aria-labelledby="energy-h">
      <div class="wrap pin-grid">
        <div class="pin">
          <h2 id="energy-h" class="t-h2"><span>Smart. Warm.</span><span>A little offbeat.</span></h2>
          <p class="note">Thoughtfully produced without feeling produced. Fun without feeling forced.</p>
        </div>
        <ul class="traits">
          {
            traits.map((t) => (
              <li class="trait">
                <h3 class="t-h3">{t.t}</h3>
                <p class="t-l">{t.b}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 4. The host, on a floating panel -->
    <section class="float" id="float" aria-labelledby="host-h">
      <div class="float-panel on-dark">
        <div class="wrap">
          <h2 id="host-h" class="t-h2 host-h"><span>The best stories</span><span>never make the bio.</span></h2>
          <div class="host-grid">
            <figure class="host-photo">
              <img src="/marcy.webp" width="944" height="1108" alt="Marcy, smiling, in the driver’s seat of her car" loading="lazy" />
              <figcaption class="t-s">Hosted by Marcy</figcaption>
            </figure>
            <div class="host-copy">
              <p class="t-h3 lit-text" id="marcy-text">
                What stayed with Marcy wasn’t the credits. It was the side conversations, the stories people
                tell once the formal part is over.
              </p>
              <p class="t-l host-small">This show brings them into the open.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. The handoff -->
    <section class="handoff" aria-labelledby="handoff-h">
      <div class="wrap">
        <h2 id="handoff-h" class="t-h2"><span>Every guest leaves a question</span><span>for the next.</span></h2>
        <ol class="chain" id="chain" style="--n:3">
          {
            handoff.map((h, i) => (
              <li style={`--i:${i}`}>
                <span class="chain-stop" aria-hidden="true" />
                <h3 class="t-h4">{h.k}</h3>
                <p class="t-m chain-b">{h.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Episodes (placeholders) -->
    <section class="episodes" aria-labelledby="ep-h">
      <div class="wrap pin-grid">
        <div class="pin">
          <h2 id="ep-h" class="t-h2">Episodes</h2>
          <p class="note">
            New conversations on Apple Podcasts, Spotify and YouTube, from December. Everything here is a
            placeholder until the first one is out.
          </p>
        </div>
        <ol class="ep-list">
          {
            episodes.map((e) => (
              <li>
                <a class="ep" href={`/episodes/${e.n}`} data-soon>
                  <span class="ep-art" aria-hidden="true">
                    <span class="num">{e.n}</span>
                  </span>
                  <span class="ep-text">
                    <span class="t-h5 ep-title">{e.title}</span>
                    <span class="t-s ep-guest">{e.guest}</span>
                  </span>
                  <span class="t-s ep-when">{e.when}</span>
                  <span class="ep-go" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 7. Back to dark -->
    <section class="yours" id="join" aria-labelledby="yours-h">
      <div class="wrap">
        <h2 id="yours-h" class="t-display"><span>Everyone has one.</span><span>What’s yours?</span></h2>
        <div class="yours-row">
          <form class="sub" data-proto>
            <label class="field">
              <span>Hear the first episode the day it’s out</span>
              <div class="sub-row">
                <input type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
                <button class="btn-ink" type="submit">Count me in</button>
              </div>
            </label>
            <p class="done" role="status" hidden>You’re on the list. See you in December.</p>
            <p class="proto">Preview: this form doesn’t send anything yet.</p>
          </form>
          <p class="note">
            Or send us your unexpected detail, or a question you’d love to hear a guest answer.
            <a class="go" href="/contact">Share yours <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<script>
  const root = document.documentElement;
  root.classList.add("js");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);
  const $ = (id: string) => document.getElementById(id)!;

  const hero = $("hero");
  const frame = $("frame");
  const join = $("join");
  const float = $("float");
  const chain = $("chain");

  // Marcy's line lights word by word, as on simplysheetdesign.com.
  const marcy = $("marcy-text");
  marcy.innerHTML = (marcy.textContent || "")
    .trim()
    .split(/(\s+)/)
    .map((part) => (/\S/.test(part) ? `<span class="lw">${part}</span>` : " "))
    .join("");
  const marcyWords = [...marcy.querySelectorAll<HTMLElement>(".lw")];

  // A pinned section's progress: 0 as it pins, 1 as it lets go.
  const pinned = (el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    const stage = el.firstElementChild as HTMLElement;
    return clamp(-r.top / Math.max(1, r.height - stage.offsetHeight));
  };

  // Every scroll-linked value has a target (from the scroll) and a current
  // value that eases toward it each frame, so nothing steps or stutters.
  const cur: Record<string, number> = {};
  const targets = () => {
    const vh = innerHeight;
    const fp = pinned(frame);
    const jt = join.getBoundingClientRect().top;
    const fr = float.getBoundingClientRect();
    const mr = marcy.getBoundingClientRect();
    return {
      // From the first pixel of scrolling, "flips" turns over and the page
      // turns light with it, done within a fifth of a screen. Ease-out, so
      // it moves the moment the scroll does.
      flip: 1 - (1 - clamp(scrollY / (vh * 0.2))) ** 3,
      words: clamp(fp / 0.36),
      rule: ease(clamp((fp - 0.42) / 0.2)),
      note: ease(clamp((fp - 0.62) / 0.16)),
      f2: ease(clamp((vh * 0.95 - jt) / (vh * 0.45))),
      fi: ease(clamp((vh - fr.top) / (vh * 0.75))),
      hp: clamp((vh * 0.85 - chain.getBoundingClientRect().top) / (vh * 0.5)),
      lit: clamp((vh * 0.82 - mr.top) / (vh * 0.5)),
    };
  };

  let running = false;
  const frameStep = () => {
    const t = targets();
    let moving = false;
    for (const k in t) {
      const target = t[k as keyof typeof t];
      const c = cur[k] ?? target;
      const next = reduce ? target : c + (target - c) * 0.22;
      cur[k] = Math.abs(target - next) < 0.0005 ? target : next;
      if (cur[k] !== target) moving = true;
    }
    root.style.setProperty("--flip", (cur.flip * (1 - cur.f2)).toFixed(4));
    hero.style.setProperty("--fp", cur.flip.toFixed(4));
    frame.style.setProperty("--wp", cur.words.toFixed(4));
    frame.style.setProperty("--rp", cur.rule.toFixed(4));
    frame.style.setProperty("--np", cur.note.toFixed(4));
    float.style.setProperty("--fi", cur.fi.toFixed(4));
    chain.style.setProperty("--hp", cur.hp.toFixed(4));

    const lit = Math.round(cur.lit * marcyWords.length);
    marcyWords.forEach((w, i) => w.classList.toggle("on", i < lit));

    if (moving) requestAnimationFrame(frameStep);
    else running = false;
  };
  const kick = () => {
    if (!running) {
      running = true;
      requestAnimationFrame(frameStep);
    }
  };
  addEventListener("scroll", kick, { passive: true });
  addEventListener("resize", kick);
  kick();

  // The trait nearest the middle of the screen is the one in focus.
  const traits = [...document.querySelectorAll<HTMLElement>(".trait")];
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) traits.forEach((t) => t.classList.toggle("is-on", t === e.target));
      }),
    { rootMargin: "-45% 0px -45% 0px" },
  );
  traits.forEach((t) => io.observe(t));

  // Episode pages don't exist yet: the rows show their hover, go nowhere.
  document.querySelectorAll<HTMLAnchorElement>("a[data-soon]").forEach((a) =>
    a.addEventListener("click", (e) => e.preventDefault()),
  );

  // Prototype form: confirm on screen, send nothing.
  document.querySelectorAll<HTMLFormElement>("form[data-proto]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>(".done")!.hidden = false;
      form.reset();
    }),
  );
</script>

<style is:global>
  /* The flip mixes every ground, ink and dot by --flip (0 dark, 1 light). */
  :root:has(.site.home) {
    --flip: 0;
    --wp: 0;
    --pct: calc(var(--flip) * 100%);
    --bg: color-mix(in srgb, var(--ud-paper) var(--pct), var(--ud-charcoal));
    --fg: color-mix(in srgb, var(--ud-ink) var(--pct), var(--ud-paper));
    --dot: color-mix(in srgb, var(--ud-mustard) var(--pct), var(--ud-butter));
    --nav-dot: var(--dot);
  }
  /* No script: dark opening and close, light between, no word reveal. */
  :root:has(.site.home):not(.js) {
    --flip: 1;
    --wp: 1;
  }
  :root:not(.js) .home :is(.hero, .yours, .site-foot) {
    --bg: var(--ud-charcoal);
    --fg: var(--ud-paper);
    --muted: color-mix(in srgb, var(--ud-paper) 68%, transparent);
    background: var(--bg);
    color: var(--fg);
  }

  /* ---------- 1. opening ---------- */
  .home .hero {
    --fp: 0;
  }
  .home .hero-in {
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: flex-end;
    padding-block: clamp(24px, 4vh, 56px) clamp(48px, 9vh, 120px);
  }
  .home .hero-in > .wrap {
    width: 100%;
  }
  .home .hero-col {
    display: grid;
    justify-items: start;
  }
  /* The line row spans the full content width. */
  .home .hero-lines {
    justify-self: stretch;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(48px, 9vh, 104px);
  }
  .home .hero-lines span {
    width: 1px;
    height: clamp(140px, 30vh, 340px);
    background: currentColor;
    transform-origin: 50% 100%;
  }
  .home .hero-lines .fall {
    transform: rotate(14deg);
  }
  .home .hero-h {
    max-width: 16ch;
    perspective: 1200px;
  }
  .home .hero-go {
    margin-top: clamp(28px, 4vh, 44px);
    padding: 0 0 4px;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font: inherit;
    font-size: 15px;
    font-weight: 400;
    cursor: default;
  }
  /* One sequence, about two seconds: the row rises left to right and
     settles, the line tips, and the headline rises as it lands, the link
     just behind. */
  .js .home :is(.hero-h, .hero-go) {
    opacity: 0;
    animation: ud-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.45s forwards;
  }
  .js .home .hero-go {
    animation-delay: 1.62s;
  }

  /* "flips": a card with the word on both faces. The scroll turns it over
     on its horizontal axis, half a turn, while the page turns light. */
  .home .flipword {
    position: relative;
    display: inline-block;
    transform-style: preserve-3d;
  }
  .home .ff {
    display: inline-block;
    backface-visibility: hidden;
    transform-origin: 50% 58%;
  }
  .home .ff-front {
    transform: rotateX(calc(var(--fp) * 180deg));
  }
  .home .ff-back {
    position: absolute;
    inset: 0;
    transform: rotateX(calc(var(--fp) * 180deg - 180deg));
  }
  /* A tease once the headline has settled: "flips" tips back a little and
     drops into place, so the eye finds it before the scroll turns it. */
  .js .home .flipword {
    animation: ud-tease 1.1s cubic-bezier(0.34, 0, 0.2, 1) 2.7s;
  }
  @keyframes ud-tease {
    0%,
    100% {
      transform: none;
    }
    35% {
      transform: rotateX(-55deg);
    }
    62% {
      transform: rotateX(12deg);
    }
    80% {
      transform: rotateX(-4deg);
    }
  }

  /* The loader: the strokes rise to a waveform (heights from a sine of
     their position), settle into an even row, then one tips over. */
  .js .home .hero-lines span {
    --h: calc(0.2 + 0.8 * sin(var(--x) * 41) * sin(var(--x) * 41));
    animation: ud-wave 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(0.1s + var(--x) * 0.4s) both;
  }
  .js .home .hero-lines .fall {
    transform: none;
    animation:
      ud-wave 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(0.1s + var(--x) * 0.4s) both,
      ud-tip 0.85s cubic-bezier(0.55, 0, 0.25, 1) 1.15s both;
  }
  @keyframes ud-wave {
    0% {
      scale: 1 0;
    }
    45% {
      scale: 1 var(--h);
    }
    100% {
      scale: 1 1;
    }
  }
  @keyframes ud-tip {
    0% {
      rotate: 0deg;
    }
    70% {
      rotate: 15.5deg;
    }
    100% {
      rotate: 14deg;
    }
  }
  @keyframes ud-in {
    from {
      opacity: 0;
      filter: blur(10px);
      translate: 0 0.15em;
    }
    to {
      opacity: 1;
      filter: none;
      translate: none;
    }
  }

  .home .hero-h > span {
    display: inline;
  }

  /* ---------- the pinned stage (2) ---------- */
  /* The section is tall; its stage holds still while the scroll drives
     what happens on it, then the page moves on. */
  .home .stage {
    position: sticky;
    top: var(--nav-height);
    height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
  }
  .home .stage > .wrap {
    width: 100%;
  }
  :root:not(.js) .home .stage {
    position: static;
    height: auto;
    padding-block: clamp(96px, 14vw, 200px);
  }

  /* ---------- 2. the flip ---------- */
  .home .frame {
    --wp: 0;
    --rp: 0;
    --np: 0;
    height: 280svh;
  }
  .home .frame-grid {
    display: grid;
  }
  .home .frame-h {
    max-width: 16ch;
  }
  .home .frame-h .w {
    /* This word's own progress. */
    --l: clamp(0, calc(var(--wp) * (var(--n) + 1) - var(--i)), 1);
    display: inline-block;
    margin-right: 0.22em;
    opacity: var(--l);
    translate: 0 calc((1 - var(--l)) * 0.3em);
  }
  /* Then a rule draws across under the headline, left to right... */
  .home .frame-rule {
    display: block;
    height: 1px;
    margin-top: clamp(40px, 6vh, 72px);
    background: var(--fg);
    transform: scaleX(var(--rp));
    transform-origin: 0 50%;
  }
  /* ...and the note settles in under its right end. */
  .home .frame-note {
    justify-self: end;
    max-width: 40ch;
    margin-top: 28px;
    color: var(--muted);
    opacity: var(--np);
    translate: 0 calc((1 - var(--np)) * 14px);
  }
  :root:not(.js) .home .frame {
    --wp: 1;
    --rp: 1;
    --np: 1;
    height: auto;
  }

  /* ---------- pinned heading, passing content (3 and 6) ---------- */
  .home .pin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .home .pin {
    position: sticky;
    top: calc(var(--nav-height) + clamp(40px, 9vh, 112px));
  }
  .home .pin .note {
    margin-top: 24px;
  }

  /* ---------- 3. energy ---------- */
  /* A long breath after the second section, then the heading holds on the
     left while the traits pass on the right, the one in the middle of the
     screen in focus. */
  .home .energy {
    padding-block: clamp(160px, 26vh, 300px) clamp(120px, 16vw, 220px);
  }
  .home .traits {
    border-top: 1px solid var(--rule);
  }
  .home .trait {
    min-height: 44vh;
    padding-block: 28px clamp(48px, 10vh, 96px);
    border-bottom: 1px solid var(--rule);
    opacity: 0.4;
    transition: opacity 0.5s var(--ease);
  }
  .home .trait.is-on,
  :root:not(.js) .home .trait {
    opacity: 1;
  }
  .home .trait p {
    margin-top: 14px;
    max-width: 34ch;
    color: var(--muted);
  }

  /* ---------- 4. the floating panel ---------- */
  /* The panel is always full width, so its content never changes width;
     only its visible edge grows, by a clip that starts one gutter in on
     each side with round corners and opens to the full screen. */
  .home .float {
    --fi: 0;
  }
  .home .float-panel {
    padding-block: clamp(96px, 14vw, 200px);
    clip-path: inset(
      0 calc((1 - var(--fi)) * var(--gutter)) round calc((1 - var(--fi)) * 24px)
    );
  }
  :root:not(.js) .home .float {
    --fi: 1;
  }
  /* Content keeps clear of the clipped edge even before the panel opens. */
  .home .float-panel > .wrap {
    padding-inline: calc(var(--gutter) + clamp(20px, 4vw, 64px));
  }
  .home .host-h {
    max-width: 16ch;
  }
  .home .host-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px clamp(40px, 7vw, 128px);
    align-items: end;
    margin-top: clamp(56px, 8vw, 112px);
  }
  .home .host-photo {
    max-width: 440px;
