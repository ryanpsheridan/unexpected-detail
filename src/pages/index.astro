---
/*
  Home, round one: a first pass at the podcast's own site, ahead of the
  December 2026 launch. Built from the concept deck and one-pagers, with the
  review notes applied:

  - Dark up top. Scrolling into "Curiosity flips the frame" flips the whole
    page to light, as one continuous change rather than section by section,
    and the rest stays light. The nav flips with it.
  - Gloock only for the logo and for numbering. Geist for everything else.
  - Butter is for dark grounds and the dot. On light it would not read, so
    text accents there use Honey, the darker secondary added in this round.
  - Listener facing: no conversation rhythm (that stays internal), no
    mission line, no "endlessly layered".
  - Intrigue instead of "coming soon", and a way to hear about the launch.

  The forms are a prototype: they confirm on screen and send nothing yet.
*/
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import "../styles/wordmark.css";

const fontsHref = "https://fonts.googleapis.com/css2?family=Gloock&display=swap";

// The opening's falling line, as HTML so the row stretches to any width
// without skewing the angle. Every other line drops out on phones; the
// fallen one is odd, so it stays.
const heroLines = 37;
const heroFall = 25;

const looking = ["the detours", "half-formed ideas", "quiet obsessions", "the story underneath"];

const promise = [
  { title: "A new insight", body: "Something that makes you think differently." },
  { title: "An unexpected laugh", body: "A spontaneous moment that catches you off guard." },
  { title: "A richer picture", body: "A reminder that people are bigger than their bios." },
];
---

<Layout
  title="unexpected detail, a podcast hosted by Marcy"
  description="A conversation show about what rarely makes the official biography. Hosted by Marcy. First episode December 2026."
>
  <link rel="stylesheet" href={fontsHref} />
  <main id="main" class="home">
    <!-- Opening: dark -->
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-meta wrap">
        <p class="over">A podcast hosted by Marcy</p>
        <p class="over">Episode <span class="num">01</span> · December 2026</p>
      </div>

      <div class="hero-lines" aria-hidden="true">
        {Array.from({ length: heroLines }, (_, i) => <span class:list={{ fall: i + 1 === heroFall }} />)}
      </div>

      <div class="hero-foot wrap">
        <div class="hero-copy">
          <h1 id="hero-h">Good questions. <span class="accent">Great detours.</span></h1>
          <p class="lede">A conversation show about what rarely makes the official biography.</p>
          <div class="actions">
            <a class="pill pill--solid" href="#join">Hear the first one</a>
            <a class="pill" href="#frame">What is this?</a>
          </div>
        </div>
        <Wordmark class="hero-wm" size="clamp(56px, 8vw, 136px)" />
      </div>
    </section>

    <!-- The flip: the page turns from dark to light while this pins -->
    <section class="frame" id="frame" aria-labelledby="frame-h">
      <div class="frame-stage">
        <div class="wrap frame-inner">
          <p class="over">The big idea</p>
          <h2 id="frame-h" class="statement">Curiosity flips the frame.</h2>
          <div class="frame-copy">
            <p>
              We live in an age of polished talking points, rehearsed press tours, and curated bios. We
              know what people do, what they’ve won, and what they’re supposed to sell next.
            </p>
            <p>
              Unexpected Detail goes past all of that. No one is just their résumé.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What we look for -->
    <section class="sect" aria-labelledby="look-h">
      <div class="wrap split">
        <div>
          <p class="over">More than the résumé</p>
          <h2 id="look-h" class="h2">A podcast built around what rarely makes the final edit.</h2>
          <p class="body">
            The unexpected detail is not always a revelation. It might be funny, obscure, brilliant,
            eccentric, or simply fascinating.
          </p>
        </div>
        <ol class="looking" aria-label="What we go looking for">
          {
            looking.map((item, i) => (
              <li class="reveal">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <span class:list={["looking-word", { accent: i === 2 }]}>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Listener promise -->
    <section class="sect sect--rule" aria-labelledby="promise-h">
      <div class="wrap">
        <p class="over">Every episode leaves you with</p>
        <h2 id="promise-h" class="h2 h2--wide">Come for the person. Stay for the detour.</h2>
        <ul class="promise">
          {
            promise.map((p, i) => (
              <li class="reveal">
                <span class="num num--lg">{String(i + 1).padStart(2, "0")}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- The handoff -->
    <section class="sect sect--rule" aria-labelledby="handoff-h">
      <div class="wrap split">
        <div>
          <p class="over">The handoff</p>
          <h2 id="handoff-h" class="h2">Every conversation opens with a stranger’s question.</h2>
          <p class="body">
            Each guest answers a question left by the guest before them, then leaves one for someone
            they have never met. One question, passed hand to hand, episode to episode.
          </p>
        </div>
        <div class="chain" aria-label="How the handoff works">
          <div class="card reveal">
            <p class="card-k"><span class="num">01</span> First guest leaves</p>
            <p class="card-q">“What’s something you were sure would be a hit that never made it?”</p>
          </div>
          <div class="card card--sealed reveal" aria-label="A question for the next guest, sealed until the episode airs">
            <p class="card-k"><span class="num">02</span> Next guest answers, then leaves</p>
            <p class="card-q" aria-hidden="true">“What did you completely change your mind about, and who changed it?”</p>
            <p class="card-seal">Sealed until it airs</p>
          </div>
        </div>
      </div>
    </section>

    <!-- The host -->
    <section class="sect sect--rule" aria-labelledby="host-h">
      <div class="wrap host">
        <figure class="host-photo reveal">
          <img src="/marcy.webp" width="944" height="1108" alt="Marcy, smiling, in the driver’s seat of her car" loading="lazy" />
        </figure>
        <div class="host-copy">
          <p class="over">Your host</p>
          <h2 id="host-h" class="h2">Marcy leads with curiosity.</h2>
          <p class="body">
            Warm, observant, and always open to an unscripted detour. Her work in beauty and creative
            production took her from New York to Brazil, Prague, and Africa. What stayed with her
            wasn’t the credits. It was the side conversations: the stories people tell once the formal
            part is over.
          </p>
          <p class="body">This show brings those conversations into the open.</p>
        </div>
      </div>
    </section>

    <!-- Everyone has one / join -->
    <section class="sect sect--rule join" id="join" aria-labelledby="join-h">
      <div class="wrap split">
        <div>
          <h2 id="join-h" class="statement statement--sm">Everyone has one. <span class="accent">What’s yours?</span></h2>
          <p class="body">
            Every guest, every listener, and Marcy herself has an unexpected detail. Send us yours, or a
            question you’d love to hear a guest answer. The next episode might start with it.
          </p>
        </div>

        <div class="forms">
          <form class="form" data-proto>
            <label for="j-email" class="form-k">Hear about episode <span class="num">01</span></label>
            <div class="field-row">
              <input id="j-email" type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
              <button class="pill pill--solid" type="submit">Count me in</button>
            </div>
            <p class="form-done" role="status" hidden>You’re on the list. See you in December.</p>
          </form>

          <form class="form" data-proto>
            <fieldset class="seg">
              <legend class="form-k">Or send us something</legend>
              <label><input type="radio" name="kind" value="detail" checked /> <span>My unexpected detail</span></label>
              <label><input type="radio" name="kind" value="question" /> <span>A question for a guest</span></label>
            </fieldset>
            <label for="j-note" class="visually-hidden">Your message</label>
            <textarea id="j-note" name="note" rows="3" placeholder="I once…" required></textarea>
            <button class="pill" type="submit">Send it</button>
            <p class="form-done" role="status" hidden>Got it. Thank you for sharing.</p>
          </form>
          <p class="proto-note">Preview: these forms don’t send anything yet.</p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot-row">
        <Wordmark class="foot-wm" size="clamp(40px, 6vw, 72px)" />
        <div class="foot-cols">
          <div>
            <p class="over">Listen</p>
            <p>Apple Podcasts · Spotify · YouTube</p>
            <p class="muted">From December 2026</p>
          </div>
          <div>
            <p class="over">Follow</p>
            <p>@unexpecteddetail</p>
            <p class="muted">Instagram · Facebook</p>
          </div>
        </div>
      </div>
      <div class="wrap foot-end">
        <p class="accent">Curiosity flips the frame.</p>
        <p class="muted">© 2026 Unexpected Detail</p>
      </div>
    </footer>
  </main>
</Layout>

<script>
  const root = document.documentElement;
  const frame = document.getElementById("frame")!;
  root.classList.add("js-flip");

  // 0 while the frame section is below the fold, 1 once it has pinned for a
  // while. Everything that flips reads this one number.
  let ticking = false;
  const update = () => {
    ticking = false;
    const r = frame.getBoundingClientRect();
    const vh = innerHeight;
    const start = vh * 0.45; // section top this far down the screen: still dark
    const end = vh * 0.05; // section top this close to the top: fully light
    const t = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
    // Smoothstep, steepened: lingers at each end and passes the grey middle fast.
    const s = t * t * (3 - 2 * t);
    const p = s * s * (3 - 2 * s);
    root.style.setProperty("--flip", p.toFixed(3));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  update();

  // Items rise in once, as they reach the screen.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      }),
    { rootMargin: "0px 0px -10% 0px" },
  );
  document.querySelectorAll(".home .reveal").forEach((el) => io.observe(el));

  // Prototype forms: confirm on screen, send nothing.
  document.querySelectorAll<HTMLFormElement>("form[data-proto]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>(".form-done")!.hidden = false;
      form.reset();
    }),
  );
</script>

<style is:global>
  /*
    The flip. --flip runs 0 to 1 (set by the script above); every ground and
    ink on the page mixes between its dark and light value by it, and the
    nav reads the same pair. Without the script, the hero is dark and the
    rest light, by their own backgrounds.
  */
  :root:has(.home) {
    --ud-ink: #141414;
    --ud-paper: #faf9f6;
    --ud-charcoal: #2a2a28;
    --ud-butter: #e8cb6a;
    /* The darker secondary: butter's family, 5.5:1 on paper, for text. */
    --ud-honey: #7d6118;
    --flip: 0;
    --pct: calc(var(--flip) * 100%);
    --bg: color-mix(in srgb, var(--ud-paper) var(--pct), var(--ud-charcoal));
    --fg: color-mix(in srgb, var(--ud-ink) var(--pct), var(--ud-paper));
    --muted: color-mix(in srgb, var(--fg) 64%, transparent);
    --rule: color-mix(in srgb, var(--fg) 14%, transparent);
    --accent: color-mix(in srgb, var(--ud-honey) var(--pct), var(--ud-butter));
    --dot: var(--ud-butter);
    --nav-bg: var(--bg);
    --nav-fg: var(--fg);
    --gutter: clamp(16px, 4.4vw, 64px);
    --page-padding: var(--gutter);
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  :root:has(.home) body {
    background: var(--bg);
    color: var(--fg);
  }
  /* No script: fixed grounds instead of the scroll-linked mix. */
  :root:has(.home):not(.js-flip) {
    --flip: 1;
  }
  :root:not(.js-flip) .hero {
    --bg: var(--ud-charcoal);
    --fg: var(--ud-paper);
    --accent: var(--ud-butter);
    background: var(--bg);
    color: var(--fg);
  }

  .home {
    font-family: var(--font-sans);
    font-weight: 300;
    overflow-x: clip;
  }
  .home :where(h1, h2, h3, p, ul, ol, figure) {
    margin: 0;
  }
  .home :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .home :where(h1, h2, h3) {
    color: inherit;
    font-weight: 400;
  }
  .home .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .home .accent {
    color: var(--accent);
  }
  .home .muted {
    color: var(--muted);
  }

  /* Overlines: Geist, small caps-height, tracked, as in the deck. */
  .home .over {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* Gloock is allowed one job beyond the logo: numbers. */
  .home .num {
    font-family: "Gloock", Georgia, serif;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }
  .home .num--lg {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    color: var(--accent);
  }

  .home .h2 {
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-top: 16px;
    max-width: 18ch;
  }
  .home .h2--wide {
    max-width: 24ch;
  }
  .home .body {
    margin-top: 20px;
    max-width: 52ch;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--muted);
  }
  .home .statement {
    font-size: clamp(44px, 8.4vw, 136px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 400;
  }
  .home .statement--sm {
    font-size: clamp(40px, 5.6vw, 88px);
    max-width: 11ch;
  }

  /* Buttons */
  .home .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid currentColor;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }
  .home .pill:hover {
    color: inherit;
    opacity: 0.75;
  }
  .home .pill--solid {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .home .pill--solid:hover {
    color: var(--bg);
  }

  /* ---------- hero ---------- */
  .home .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-height));
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 12px 0 clamp(28px, 5vw, 64px);
  }
  .home .hero-meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .home .hero-lines {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: clamp(32px, 6vh, 72px) var(--gutter);
  }
  .home .hero-lines span {
    width: 1px;
    height: clamp(140px, 26vh, 300px);
    background: currentColor;
    transform-origin: 50% 100%;
  }
  .home .hero-lines .fall {
    transform: rotate(14deg);
  }
  .js-flip .home .hero-lines .fall {
    animation: ud-fall 1.4s cubic-bezier(0.55, 0, 0.3, 1) 0.4s both;
  }
  @keyframes ud-fall {
    0%,
    20% {
      transform: none;
    }
    80% {
      transform: rotate(15deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .home .hero-foot {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .home .hero h1 {
    font-size: clamp(36px, 4.6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 10ch;
  }
  .home .hero h1 .accent {
    display: block;
  }
  .home .lede {
    margin-top: 20px;
    max-width: 34ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    color: var(--muted);
  }
  .home .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .home .hero-wm {
    flex: none;
  }

  /* ---------- the flip ---------- */
  .home .frame {
    position: relative;
    height: 200svh;
  }
  .home .frame-stage {
    position: sticky;
    top: var(--nav-height);
    height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
  }
  .home .frame-inner {
    width: 100%;
  }
  .home .frame .statement {
    margin-top: 20px;
    max-width: 12ch;
  }
  .home .frame-copy {
    margin-top: clamp(28px, 4vw, 48px);
    margin-left: auto;
    max-width: 44ch;
    display: grid;
    gap: 16px;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.55;
    /* Arrives as the page turns light. */
    opacity: calc(var(--flip) * 1.6 - 0.6);
    transform: translateY(calc((1 - var(--flip)) * 24px));
  }
  :root:not(.js-flip) .home .frame-copy {
    opacity: 1;
    transform: none;
  }
  :root:not(.js-flip) .home .frame {
    height: auto;
    padding: clamp(80px, 12vw, 160px) 0;
  }
  :root:not(.js-flip) .home .frame-stage {
    position: static;
    height: auto;
  }

  /* ---------- sections ---------- */
  .home .sect {
    padding: clamp(72px, 10vw, 144px) 0;
  }
  .home .sect--rule > .wrap {
    position: relative;
  }
  .home .sect--rule > .wrap::before {
    content: "";
    position: absolute;
    top: calc(clamp(72px, 10vw, 144px) * -1);
    left: var(--gutter);
    right: var(--gutter);
    border-top: 1px solid var(--rule);
  }
  .home .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .home .looking li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .home .looking li:first-child {
    border-top: 1px solid var(--rule);
  }
  .home .looking .num {
    font-size: 16px;
    color: var(--muted);
    width: 2ch;
  }
  .home .looking-word {
    font-size: clamp(26px, 3vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .home .promise {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }
  .home .promise li {
    padding-top: 24px;
    border-top: 1px solid var(--fg);
  }
  .home .promise h3 {
    margin-top: 28px;
    font-size: clamp(20px, 1.8vw, 26px);
    letter-spacing: -0.02em;
  }
  .home .promise p {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.55;
  }

  .home .chain {
    display: grid;
    gap: 16px;
  }
  .home .card {
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .home .card:first-child {
    background: color-mix(in srgb, var(--ud-butter) 22%, var(--bg));
    border-color: transparent;
  }
  .home .card-k {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .home .card-k .num {
    color: var(--accent);
    font-size: 15px;
    margin-right: 6px;
  }
  .home .card-q {
    margin-top: 16px;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .home .card--sealed {
    position: relative;
    overflow: hidden;
  }
  .home .card--sealed .card-q {
    filter: blur(7px);
    user-select: none;
  }
  .home .card-seal {
    position: absolute;
    right: clamp(24px, 3vw, 36px);
    bottom: clamp(24px, 3vw, 36px);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 12px;
    font-weight: 500;
  }

  .home .host {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .home .host-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 944 / 1108;
    object-fit: cover;
  }

  .home .forms {
    display: grid;
    gap: 40px;
  }
  .home .form {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .home .form-k {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0;
  }
  .home .field-row {
    width: 100%;
    display: flex;
    gap: 10px;
  }
  .home input[type="email"],
  .home textarea {
    width: 100%;
    font: inherit;
    font-size: 17px;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--fg);
    border-radius: 0;
    padding: 12px 0;
  }
  .home textarea {
    resize: vertical;
    border: 1px solid var(--rule);
    border-bottom-color: var(--fg);
    padding: 12px 14px;
  }
  .home input::placeholder,
  .home textarea::placeholder {
    color: var(--muted);
  }
  .home .seg {
