---
/*
  Home, round one: the podcast's public site, ahead of the December 2026
  launch. In the concept page's quiet system (src/styles/site.css): paper,
  ink, hairlines, small labels, one idea per spread, and a lot of room.

  The story opens dark, with the falling line and the wordmark. Scrolling
  into the headline "Curiosity flips the frame" turns the whole page light,
  as one continuous change while the headline holds still; the nav turns
  with it, and everything after stays light.

  Gloock only for the logo and numbers. No gold text anywhere: butter is
  only the dot of the i. The conversation rhythm and the old mission line
  stay internal.
*/
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/wordmark.css";
import "../styles/site.css";

const fontsHref = "https://fonts.googleapis.com/css2?family=Gloock&display=swap";

// The falling line, as on the concept page's opening. Every other line
// drops out on phones; the fallen one is odd, so it stays.
const heroLines = 37;
const heroFall = 25;
---

<Layout
  title="unexpected detail, a podcast hosted by Marcy"
  description="A conversation show about what rarely makes the official biography. Hosted by Marcy. First episode December 2026."
>
  <link rel="stylesheet" href={fontsHref} />
  <main id="main" class="site home">
    <!-- Opening: dark -->
    <section class="hero" aria-label="unexpected detail">
      <div class="hero-meta wrap">
        <p>A podcast hosted by Marcy</p>
        <p class="hero-when">Episode <span class="num">01</span>, December 2026</p>
      </div>
      <div class="hero-lines" aria-hidden="true">
        {Array.from({ length: heroLines }, (_, i) => <span class:list={{ fall: i + 1 === heroFall }} />)}
      </div>
      <div class="hero-foot wrap">
        <h1 class="hero-desc">A conversation show about what rarely makes the official biography.</h1>
        <Wordmark class="hero-wm" size="clamp(44px, 9.6vw, 168px)" />
      </div>
    </section>

    <!-- The flip: the page turns light while this headline holds -->
    <section class="frame" id="frame" aria-labelledby="frame-h">
      <div class="frame-stage">
        <div class="wrap">
          <h2 id="frame-h" class="frame-h">Curiosity flips the frame.</h2>
          <p class="frame-note">
            We know what people do, what they’ve won, and what they’re supposed to sell next. This
            show is about everything else.
          </p>
        </div>
      </div>
    </section>

    <!-- 01 The show -->
    <section class="spread" aria-labelledby="s1">
      <div class="wrap">
        <div class="slabel"><span class="num">01</span><h2 id="s1">The show</h2></div>
        <div class="say reveal">
          <p class="line">Good questions. Great detours.</p>
          <div>
            <p class="note">Not an interview to get through. A conversation you want to be part of.</p>
            <p class="note">
              Unexpected Detail goes past the résumé, to the detours, half-formed ideas, quiet
              obsessions, and stories that make people who they are.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 The detail -->
    <section class="spread spread--tight" aria-labelledby="s2">
      <div class="wrap">
        <div class="slabel"><span class="num">02</span><h2 id="s2">The detail</h2></div>
        <div class="say reveal">
          <p class="line">It isn’t always a revelation.</p>
          <p class="note">
            It might be funny, obscure, brilliant, eccentric, or simply fascinating. The substance comes
            from the guests and the questions, not from serious-sounding language.
          </p>
        </div>
      </div>
    </section>

    <!-- 03 The host -->
    <section class="spread spread--tight" aria-labelledby="s3">
      <div class="wrap">
        <div class="slabel"><span class="num">03</span><h2 id="s3">The host</h2></div>
        <div class="host reveal">
          <figure class="host-photo">
            <img src="/marcy.webp" width="944" height="1108" alt="Marcy, smiling, in the driver’s seat of her car" loading="lazy" />
          </figure>
          <div class="host-copy">
            <p class="line">Hosted by Marcy.</p>
            <p class="note">
              Warm, observant, and always open to an unscripted detour. Her work in beauty and creative
              production took her from New York to Brazil, Prague, and Africa. What stayed with her
              wasn’t the credits. It was the side conversations, the stories people tell once the formal
              part is over.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 The handoff -->
    <section class="spread spread--tight" aria-labelledby="s4">
      <div class="wrap">
        <div class="slabel"><span class="num">04</span><h2 id="s4">The handoff</h2></div>
        <div class="say reveal">
          <p class="line">Every guest leaves a question for the next.</p>
          <p class="note">
            Each episode opens with a question from the guest before, asked of someone they have never
            met. Then the new guest leaves one of their own.
          </p>
        </div>
      </div>
    </section>

    <!-- 05 Yours -->
    <section class="spread spread--tight" id="join" aria-labelledby="s5">
      <div class="wrap">
        <div class="slabel"><span class="num">05</span><h2 id="s5">Yours</h2></div>
        <div class="say reveal">
          <div>
            <p class="line">Everyone has one. What’s yours?</p>
            <a class="go" href="/contact">Share your detail <span aria-hidden="true">→</span></a>
          </div>
          <form class="sub" data-proto>
            <label class="field">
              <span>Hear when episode <span class="num">01</span> is out</span>
              <input type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
            </label>
            <button class="btn-ink" type="submit">Count me in</button>
            <p class="done" role="status" hidden>You’re on the list. See you in December.</p>
            <p class="proto">Preview: this form doesn’t send anything yet.</p>
          </form>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<script>
  const root = document.documentElement;
  const frame = document.getElementById("frame")!;
  root.classList.add("js");

  // --flip runs 0 (dark) to 1 (light) as the headline's section reaches the
  // top of the screen. Eased twice, so it lingers at each end and passes the
  // grey middle quickly.
  let ticking = false;
  const update = () => {
    ticking = false;
    const top = frame.getBoundingClientRect().top;
    const start = innerHeight * 0.4;
    const end = -innerHeight * 0.1;
    const t = Math.min(1, Math.max(0, (start - top) / (start - end)));
    const s = t * t * (3 - 2 * t);
    root.style.setProperty("--flip", (s * s * (3 - 2 * s)).toFixed(3));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  update();

  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      }),
    { rootMargin: "0px 0px -12% 0px" },
  );
  document.querySelectorAll(".site .reveal").forEach((el) => io.observe(el));

  // Prototype: confirm on screen, send nothing.
  document.querySelectorAll<HTMLFormElement>("form[data-proto]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>(".done")!.hidden = false;
      form.reset();
    }),
  );
</script>

<style is:global>
  /* The flip: every ground and ink on the page mixes by --flip. Without the
     script, the opening is dark by its own background and the rest light. */
  :root:has(.site.home) {
    --flip: 0;
    --bg: color-mix(in srgb, var(--ud-paper) calc(var(--flip) * 100%), var(--ud-charcoal));
    --fg: color-mix(in srgb, var(--ud-ink) calc(var(--flip) * 100%), var(--ud-paper));
  }
  :root:has(.site.home):not(.js) {
    --flip: 1;
  }
  :root:not(.js) .home .hero {
    --bg: var(--ud-charcoal);
    --fg: var(--ud-paper);
    background: var(--bg);
    color: var(--fg);
  }

  /* ---------- opening ---------- */
  .home .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-height));
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 8px 0 clamp(28px, 4.4vw, 64px);
  }
  .home .hero-meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .home .hero-lines {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(40px, 7vh, 88px) var(--gutter);
  }
  .home .hero-lines span {
    width: 1px;
    height: clamp(140px, 24vh, 280px);
    background: currentColor;
    transform-origin: 50% 100%;
  }
  .home .hero-lines .fall {
    transform: rotate(14deg);
  }
  .js .home .hero-lines .fall {
    animation: ud-fall 1.4s cubic-bezier(0.55, 0, 0.3, 1) 0.5s both;
  }
  @keyframes ud-fall {
    0%,
    20% {
      transform: none;
    }
    80% {
      transform: rotate(15deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .home .hero-foot {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }
  .home .hero-desc {
    max-width: 28ch;
    padding-bottom: 0.4em;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.55;
    color: var(--muted);
  }
  .home .hero-wm {
    flex: none;
  }

  /* ---------- the flip ---------- */
  .home .frame {
    height: 190svh;
  }
  .home .frame-stage {
    position: sticky;
    top: var(--nav-height);
    height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
  }
  .home .frame-stage > .wrap {
    width: 100%;
  }
  .home .frame-h {
    font-size: clamp(48px, 8.8vw, 152px);
    line-height: 0.96;
    letter-spacing: -0.05em;
    max-width: 11ch;
  }
  .home .frame-note {
    margin: clamp(32px, 4vw, 56px) 0 0 auto;
    max-width: 36ch;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--muted);
    opacity: calc(var(--flip) * 2 - 1);
    transform: translateY(calc((1 - var(--flip)) * 16px));
  }
  :root:not(.js) .home .frame {
    height: auto;
  }
  :root:not(.js) .home .frame-stage {
    position: static;
    height: auto;
    padding-block: clamp(96px, 14vw, 200px);
  }
  :root:not(.js) .home .frame-note {
    opacity: 1;
    transform: none;
  }

  /* ---------- spreads ---------- */
  .home .spread--tight {
    padding-top: 0;
  }
  .home .host {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5fr;
    gap: 40px clamp(40px, 6vw, 112px);
    align-items: end;
    margin-top: clamp(56px, 8vw, 120px);
  }
  .home .host-photo {
    max-width: 440px;
  }
  .home .host-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 944 / 1108;
    object-fit: cover;
  }
  .home .host-copy .note {
    margin-top: 28px;
  }
  .home .sub {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 420px;
    width: 100%;
  }
  .home .sub .field {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .home .hero-lines .fall {
      animation: none;
    }
    .home .frame-note {
      transform: none;
    }
  }
  @media (max-width: 820px) {
    .home .hero-lines span:nth-child(even) {
      display: none;
    }
    .home .hero-foot {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .home .hero-wm {
      align-self: flex-end;
    }
    .home .host {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .home .hero-when {
      display: none;
    }
  }
</style>
