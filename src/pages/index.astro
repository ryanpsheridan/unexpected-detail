---
/*
  Home, round three: the podcast's public site for future listeners, ahead
  of the December 2026 launch (PRODUCT.md). In the concept page's system,
  on the type scale in src/styles/site.css.

  The story, top to bottom:
  1. Dark. The primary logo, large: its falling line rises as a waveform,
     settles into an even row, and one line tips over. Then the line that
     says what the show is.
  2. A long breath of dark, then "Curiosity flips the frame." arrives word
     by word with the scroll, "frame." turning over last, and only then the
     page flips to light. Nothing pins; the scroll never stops.
  3. Smart. Warm. A little offbeat: the heading holds while the traits pass.
  4. A floating dark panel (after berryreader.com) that grows to full
     width as it arrives and insets again as it leaves: Marcy, and the
     side conversations.
  5. The handoff: a line the reader draws with their own scroll.
  6. Episodes: the heading holds while placeholder episodes pass.
  7. The page flips back to dark, as smoothly as it flipped to light:
     Everyone has one. What's yours?

  No gold text. Butter is the dot on dark; Mustard (#B8890F, 3:1 on
  paper) is the dot and the graphic accent on light.
*/
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/wordmark.css";
import "../styles/site.css";

const frameWords = ["Curiosity", "flips", "the", "frame."];

const traits = [
  { t: "Smart and substantial", b: "Real ideas and opinions, worth thinking about afterward." },
  { t: "Genuinely curious", b: "Interested in people, not their titles." },
  { t: "Playful and a little eccentric", b: "Witty, expressive, and happy to follow a tangent." },
  { t: "Warm and easy", b: "Comfortable and spontaneous. Never intimidating." },
];

const handoff = [
  { k: "The last guest", b: "leaves a question for someone they have never met." },
  { k: "This episode", b: "opens with it. The new guest answers, then leaves one of their own." },
  { k: "The next guest", b: "hears it for the first time, on the mic." },
];

// Placeholders until Riverside publishes real episodes. Each row will open
// its own page at /episodes/NN; those pages don't exist yet.
const episodes = [
  { n: "01", title: "The first conversation", guest: "Guest to be announced", when: "December 2026" },
  ...Array.from({ length: 8 }, (_, i) => ({
    n: String(i + 2).padStart(2, "0"),
    title: "Episode title to come",
    guest: "Guest to be announced",
    when: "2027",
  })),
];
---

<Layout
  title="unexpected detail, a podcast hosted by Marcy"
  description="A podcast built around what rarely makes the final edit. Hosted by Marcy. First episode December 2026."
>
  <main id="main" class="site home">
    <!-- 1. Opening -->
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap hero-inner">
        <h1 id="hero-h" class="hero-h"><Wordmark class="hero-wm" size="min(calc((100vw - 2 * var(--gutter)) / 6.5), 30svh)" lines /></h1>
        <p class="hero-sub t-h2">A podcast built around what rarely makes the final edit.</p>
      </div>
    </section>

    <!-- 2. The flip -->
    <section class="frame" id="frame" aria-labelledby="frame-h">
      <div class="wrap frame-grid">
        <h2 id="frame-h" class="t-h1 frame-h" aria-label="Curiosity flips the frame.">
          {
            frameWords.map((w, i) => (
              <span class:list={["w", { "w-flip": i === frameWords.length - 1 }]} style={`--i:${i}`} aria-hidden="true">
                {w}
              </span>
            ))
          }
        </h2>
        <p class="t-l frame-note">
          We know what people do, what they’ve won, and what they’re supposed to sell next. This show is
          about everything else: the detours, the half-formed ideas, the quiet obsessions.
        </p>
      </div>
    </section>

    <!-- 3. The energy -->
    <section class="energy" aria-labelledby="energy-h">
      <div class="wrap pin-grid">
        <div class="pin">
          <h2 id="energy-h" class="t-h2"><span>Smart. Warm.</span><span>A little offbeat.</span></h2>
          <p class="note">Thoughtfully produced without feeling produced. Fun without feeling forced.</p>
        </div>
        <ol class="traits">
          {
            traits.map((t) => (
              <li class="trait">
                <h3 class="t-h3">{t.t}</h3>
                <p class="t-l">{t.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 4. The host, on a floating panel -->
    <section class="float" id="float" aria-labelledby="host-h">
      <div class="float-panel on-dark">
        <div class="wrap">
          <h2 id="host-h" class="t-h2 host-h"><span>The best stories</span><span>never make the bio.</span></h2>
          <div class="host-grid">
            <figure class="host-photo">
              <img src="/marcy.webp" width="944" height="1108" alt="Marcy, smiling, in the driver’s seat of her car" loading="lazy" />
              <figcaption class="t-s">Hosted by Marcy</figcaption>
            </figure>
            <div class="host-copy">
              <p class="t-h3">
                What stayed with Marcy wasn’t the credits. It was the side conversations, the stories people
                tell once the formal part is over.
              </p>
              <p class="t-l host-small">This show brings them into the open.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. The handoff -->
    <section class="handoff" aria-labelledby="handoff-h">
      <div class="wrap">
        <h2 id="handoff-h" class="t-h2"><span>Every guest leaves a question</span><span>for the next.</span></h2>
        <ol class="chain" id="chain" style="--n:3">
          {
            handoff.map((h, i) => (
              <li style={`--i:${i}`}>
                <span class="chain-stop" aria-hidden="true" />
                <h3 class="t-h4">{h.k}</h3>
                <p class="t-m chain-b">{h.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Episodes (placeholders) -->
    <section class="episodes" aria-labelledby="ep-h">
      <div class="wrap pin-grid">
        <div class="pin">
          <h2 id="ep-h" class="t-h2">Episodes</h2>
          <p class="note">
            New conversations on Apple Podcasts, Spotify and YouTube, from December. Everything here is a
            placeholder until the first one is out.
          </p>
        </div>
        <ol class="ep-list">
          {
            episodes.map((e) => (
              <li>
                <a class="ep" href={`/episodes/${e.n}`} data-soon>
                  <span class="ep-art" aria-hidden="true">
                    <span class="num">{e.n}</span>
                  </span>
                  <span class="ep-text">
                    <span class="t-h5 ep-title">{e.title}</span>
                    <span class="t-s ep-guest">{e.guest}</span>
                  </span>
                  <span class="t-s ep-when">{e.when}</span>
                  <span class="ep-go" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 7. Back to dark -->
    <section class="yours" id="join" aria-labelledby="yours-h">
      <div class="wrap">
        <h2 id="yours-h" class="t-display"><span>Everyone has one.</span><span>What’s yours?</span></h2>
        <div class="yours-row">
          <form class="sub" data-proto>
            <label class="field">
              <span>Hear the first episode the day it’s out</span>
              <div class="sub-row">
                <input type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
                <button class="btn-ink" type="submit">Count me in</button>
              </div>
            </label>
            <p class="done" role="status" hidden>You’re on the list. See you in December.</p>
            <p class="proto">Preview: this form doesn’t send anything yet.</p>
          </form>
          <p class="note">
            Or send us your unexpected detail, or a question you’d love to hear a guest answer.
            <a class="go" href="/contact">Share yours <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<script>
  const root = document.documentElement;
  root.classList.add("js");
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);

  const frameH = document.querySelector<HTMLElement>(".frame-h")!;
  const join = document.getElementById("join")!;
  const float = document.getElementById("float")!;
  const chain = document.getElementById("chain")!;
  const heroWm = document.querySelector<HTMLElement>(".hero-wm")!;

  // Everything scroll-linked is computed here, once a frame, from where
  // its section sits on the screen. Lenis (in the layout) smooths the
  // scroll itself, so these follow it without any easing of their own.
  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = innerHeight;

    // The words arrive as the headline climbs from the bottom of the
    // screen to just past the middle; the page flips light after them.
    const ft = frameH.getBoundingClientRect().top;
    root.style.setProperty("--wp", clamp((vh * 0.98 - ft) / (vh * 0.48)).toFixed(4));
    const f1 = ease(clamp((vh * 0.58 - ft) / (vh * 0.4)));

    // And back to dark as the last section comes up, over the same distance.
    const jt = join.getBoundingClientRect().top;
    const f2 = ease(clamp((vh * 0.95 - jt) / (vh * 0.45)));
    root.style.setProperty("--flip", (f1 * (1 - f2)).toFixed(4));

    // The floating panel: inset with round corners at either end, full
    // width while it fills the screen.
    const fr = float.getBoundingClientRect();
    const grow = Math.min(clamp((vh - fr.top) / (vh * 0.75)), clamp(fr.bottom / (vh * 0.75)));
    float.style.setProperty("--fi", ease(grow).toFixed(4));

    // The nav's logo waits until the big one has scrolled away.
    root.classList.toggle("past-hero", heroWm.getBoundingClientRect().bottom < 40);

    // The handoff line, drawn by the scroll.
    const ct = chain.getBoundingClientRect().top;
    chain.style.setProperty("--hp", clamp((vh * 0.85 - ct) / (vh * 0.5)).toFixed(4));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  update();

  // The trait nearest the middle of the screen is the one in focus.
  const traits = [...document.querySelectorAll<HTMLElement>(".trait")];
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) traits.forEach((t) => t.classList.toggle("is-on", t === e.target));
      }),
    { rootMargin: "-45% 0px -45% 0px" },
  );
  traits.forEach((t) => io.observe(t));

  // Episode pages don't exist yet: the rows show their hover, go nowhere.
  document.querySelectorAll<HTMLAnchorElement>("a[data-soon]").forEach((a) =>
    a.addEventListener("click", (e) => e.preventDefault()),
  );

  // Prototype form: confirm on screen, send nothing.
  document.querySelectorAll<HTMLFormElement>("form[data-proto]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>(".done")!.hidden = false;
      form.reset();
    }),
  );
</script>

<style is:global>
  /* The flip mixes every ground, ink and dot by --flip (0 dark, 1 light). */
  :root:has(.site.home) {
    --flip: 0;
    --wp: 0;
    --pct: calc(var(--flip) * 100%);
    --bg: color-mix(in srgb, var(--ud-paper) var(--pct), var(--ud-charcoal));
    --fg: color-mix(in srgb, var(--ud-ink) var(--pct), var(--ud-paper));
    --dot: color-mix(in srgb, var(--ud-mustard) var(--pct), var(--ud-butter));
    --nav-dot: var(--dot);
  }
  /* No script: dark opening and close, light between, no word reveal. */
  :root:has(.site.home):not(.js) {
    --flip: 1;
    --wp: 1;
  }
  :root:not(.js) .home :is(.hero, .yours, .site-foot) {
    --bg: var(--ud-charcoal);
    --fg: var(--ud-paper);
    --muted: color-mix(in srgb, var(--ud-paper) 68%, transparent);
    background: var(--bg);
    color: var(--fg);
  }

  /* The name appears once at a time: the nav's logo stays out of view
     while the hero's is on screen. */
  .js:has(.site.home) .site-nav .logo {
    transition:
      opacity 0.4s var(--ease),
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .js:has(.site.home):not(.past-hero, :has(body.menu-open)) .site-nav .logo {
    opacity: 0;
    translate: 0 -6px;
    pointer-events: none;
  }

  /* ---------- 1. opening ---------- */
  .home .hero {
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: clamp(32px, 6vh, 80px);
  }
  .home .hero-inner {
    width: 100%;
    display: grid;
    gap: clamp(40px, 7vh, 88px);
  }
  .home .hero-h {
    display: flex;
    justify-content: flex-start;
  }
  .home .hero-sub {
    max-width: 17ch;
    justify-self: end;
    color: var(--muted);
  }

  /* The loader: the logo's strokes rise to a waveform (heights from a sine
     of their position), settle level, then one tips over. */
  .js .home .hero-wm .wm-lines > span {
    --h: calc(0.25 + 0.75 * sin(var(--x) * 37) * sin(var(--x) * 37));
    animation: ud-wave 1.6s cubic-bezier(0.16, 1, 0.3, 1) calc(0.15s + var(--x) * 0.55s) both;
  }
  .js .home .hero-wm .wm-lines > .wm-fall {
    transform: none;
    animation:
      ud-wave 1.6s cubic-bezier(0.16, 1, 0.3, 1) calc(0.15s + var(--x) * 0.55s) both,
      ud-tip 1.1s cubic-bezier(0.55, 0, 0.25, 1) 2.1s both;
  }
  @keyframes ud-wave {
    0% {
      scale: 1 0;
    }
    45% {
      scale: 1 var(--h);
    }
    100% {
      scale: 1 1;
    }
  }
  @keyframes ud-tip {
    0% {
      rotate: 0deg;
    }
    70% {
      rotate: 15.5deg;
    }
    100% {
      rotate: 14deg;
    }
  }
  /* The words follow the line. */
  .js .home .hero-wm :is(.wm-a, .wm-word),
  .js .home .hero-sub {
    animation: ud-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .js .home .hero-wm .wm-a {
    animation-delay: 0.9s;
  }
  .js .home .hero-wm .wm-word {
    animation-delay: 1.05s;
  }
  .js .home .hero-sub {
    animation-delay: 2.4s;
  }
  @keyframes ud-in {
    from {
      opacity: 0;
      filter: blur(10px);
      translate: 0 0.15em;
    }
  }

  /* ---------- 2. the flip ---------- */
  .home .frame {
    /* A long stretch of dark first, so the change has room. */
    padding-block: 60vh clamp(120px, 18vw, 240px);
  }
  .home .frame-grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .home .frame-h {
    max-width: 11ch;
    perspective: 900px;
  }
  .home .frame-h .w {
    /* This word's own progress, from the page's --wp. */
    --l: clamp(0, calc(var(--wp) * 4.6 - var(--i) * 1.2), 1);
    display: inline-block;
    margin-right: 0.22em;
    opacity: var(--l);
    filter: blur(calc((1 - var(--l)) * 12px));
    translate: 0 calc((1 - var(--l)) * 0.35em);
  }
  /* "frame." turns over into place. */
  .home .frame-h .w-flip {
    transform-origin: 50% 80%;
    rotate: x calc((1 - var(--l)) * -110deg);
    translate: none;
  }
  .home .frame-note {
    justify-self: end;
    max-width: 40ch;
    color: var(--muted);
    opacity: calc(var(--flip) * 1.5 - 0.5);
  }
  :root:not(.js) .home .frame-note {
    opacity: 1;
  }

  /* ---------- pinned heading, passing content (3 and 6) ---------- */
  .home .pin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .home .pin {
    position: sticky;
    top: calc(var(--nav-height) + clamp(40px, 9vh, 112px));
  }
  .home .pin .note {
    margin-top: 24px;
  }

  /* ---------- 3. energy ---------- */
  .home .energy {
    padding-bottom: clamp(120px, 16vw, 220px);
  }
  .home .traits {
    border-top: 1px solid var(--rule);
  }
  .home .trait {
    min-height: 44vh;
    padding-block: 28px clamp(48px, 10vh, 96px);
    border-bottom: 1px solid var(--rule);
    opacity: 0.4;
    transition: opacity 0.5s var(--ease);
  }
  .home .trait.is-on,
  :root:not(.js) .home .trait {
    opacity: 1;
  }
  .home .trait p {
    margin-top: 14px;
    max-width: 34ch;
    color: var(--muted);
  }

  /* ---------- 4. the floating panel ---------- */
  .home .float {
    --fi: 0;
    padding-inline: calc((1 - var(--fi)) * var(--gutter));
  }
  .home .float-panel {
    border-radius: calc((1 - var(--fi)) * 24px);
    padding-block: clamp(96px, 14vw, 200px);
    overflow: hidden;
  }
  .home .host-h {
    max-width: 16ch;
  }
  .home .host-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px clamp(40px, 7vw, 128px);
    align-items: end;
    margin-top: clamp(56px, 8vw, 112px);
  }
  .home .host-photo {
    max-width: 440px;
  }
  .home .host-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 944 / 1108;
    object-fit: cover;
    border-radius: 4px;
  }
  .home .host-photo figcaption {
    margin-top: 12px;
    color: var(--muted);
  }
  .home .host-copy .t-h3 {
    max-width: 22ch;
  }
  .home .host-small {
    margin-top: 28px;
    color: var(--muted);
  }

  /* ---------- 5. the handoff ---------- */
  .home .handoff {
    padding-block: clamp(120px, 16vw, 220px);
  }
  .home .chain {
    --hp: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(64px, 9vw, 128px);
    padding-top: 44px;
  }
  /* The rail, and the line drawn along it by the scroll. */
  .home .chain::before,
  .home .chain::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
  }
  .home .chain::before {
    background: var(--rule);
  }
  .home .chain::after {
    background: var(--fg);
    transform: scaleX(var(--hp));
    transform-origin: 0 50%;
  }
  .home .chain li {
    position: relative;
    /* Lit once the line reaches its stop. */
    --lit: clamp(0, calc((var(--hp) * (var(--n) - 1) - var(--i)) * 4 + 1), 1);
    opacity: calc(0.35 + 0.65 * var(--lit));
  }
  .home .chain-stop {
    position: absolute;
    top: -49px;
    left: -5px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--fg);
    box-shadow: inset 0 0 0 6px color-mix(in srgb, var(--dot) calc(var(--lit) * 100%), var(--bg));
  }
  .home .chain-b {
    margin-top: 10px;
    max-width: 30ch;
    color: var(--muted);
  }

  /* ---------- 6. episodes ---------- */
  .home .episodes {
    padding-bottom: clamp(120px, 16vw, 220px);
  }
  .home .ep-list {
    border-top: 1px solid var(--fg);
  }
  .home .ep {
    display: grid;
    grid-template-columns: clamp(72px, 7vw, 104px) 1fr auto 28px;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
    color: inherit;
  }
  .home .ep-art {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in srgb, var(--fg) 7%, var(--bg));
    transition: background-color 0.35s var(--ease);
  }
  .home .ep-art .num {
    font-size: clamp(22px, 2vw, 30px);
    color: var(--muted);
    transition:
      color 0.35s var(--ease),
      scale 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home .ep-text {
    display: grid;
    gap: 4px;
  }
  .home .ep-title {
    transition: translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home .ep-guest,
  .home .ep-when {
    color: var(--muted);
  }
  .home .ep-go {
    display: grid;
    place-items: center;
    opacity: 0;
    translate: -8px 0;
    transition:
      opacity 0.3s var(--ease),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .home .ep:is(:hover, :focus-visible) .ep-art {
    background: var(--ud-charcoal);
  }
  .home .ep:is(:hover, :focus-visible) .ep-art .num {
    color: var(--ud-paper);
    scale: 1.12;
  }
  .home .ep:is(:hover, :focus-visible) .ep-title {
    translate: 6px 0;
  }
  .home .ep:is(:hover, :focus-visible) .ep-go {
    opacity: 1;
    translate: 0 0;
  }
  .home .ep:focus-visible {
    outline-offset: 4px;
  }

  /* ---------- 7. back to dark ---------- */
  .home .yours {
    padding-block: clamp(120px, 18vw, 260px) clamp(80px, 10vw, 144px);
  }
  .home .yours-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(40px, 6vw, 112px);
    align-items: end;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .home .sub {
    display: grid;
    gap: 14px;
    max-width: 520px;
  }
  .home .sub-row {
    display: flex;
    gap: 12px;
    align-items: end;
  }
  .home .sub-row .btn-ink {
    flex: none;
    white-space: nowrap;
  }
  .home .yours .note .go {
    display: flex;
    width: fit-content;
  }

  @media (prefers-reduced-motion: reduce) {
