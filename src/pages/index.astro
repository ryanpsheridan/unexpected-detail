---
/*
  Home, round one: the podcast's public site for future listeners, ahead
  of the December 2026 launch (PRODUCT.md). In the concept page's system:
  paper and ink, hairlines, Geist for every word, Gloock only for the
  wordmark and numbers, and a lot of room.

  The story, top to bottom:
  1. Dark. The falling line draws itself in as a waveform that settles
     into an even row, then one line tips over: the unexpected detail.
     That is the page's one authored moment.
  2. "Curiosity flips the frame." The page turns light as this headline
     passes, scrolling freely, and stays light.
  3. Smart. Warm. A little offbeat. The heading holds on the left while
     the four traits pass on the right.
  4. The best stories never make the bio: Marcy's bio struck through, line
     by line, until the detail is left.
  5. The handoff, drawn as a line one question travels along.
  6. Episodes, as a placeholder for where the site grows.
  7. Everyone has one. What's yours? and the launch list.

  No gold text. Butter is the dot on dark; Mustard (#B8890F, 3:1 on
  paper) is the dot and the graphic accent on light.
*/
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/wordmark.css";
import "../styles/site.css";

// The falling line. Each stroke rises to a random waveform height, then
// settles to the even row; heights are fixed at build so the page is
// stable. Every other line drops out on phones; the fallen one is odd.
const heroLines = 37;
const heroFall = 25;
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const strokes = Array.from({ length: heroLines }, (_, i) => {
  const mid = 1 - Math.abs(i - heroLines / 2) / (heroLines / 2);
  return { h: +(0.18 + rand() * 0.55 + mid * 0.25).toFixed(2), d: +(i * 0.022 + rand() * 0.06).toFixed(3) };
});

const traits = [
  { t: "Smart and substantial", b: "Real ideas and opinions, worth thinking about afterward." },
  { t: "Genuinely curious", b: "Interested in people, not their titles." },
  { t: "Playful and a little eccentric", b: "Witty, expressive, and happy to follow a tangent." },
  { t: "Warm and easy", b: "Comfortable and spontaneous. Never intimidating." },
];

const bio = ["Beauty and creative production.", "New York, Brazil, Prague, Africa.", "Shows, shoots, and a lot of credits."];

const handoff = [
  { k: "The last guest", b: "leaves a question for someone they have never met." },
  { k: "This episode", b: "opens with it. The new guest answers, then leaves one of their own." },
  { k: "The next guest", b: "hears it for the first time, on the mic." },
];

const episodes = [
  { n: "01", title: "The first conversation", when: "December 2026" },
  { n: "02", title: "To be announced", when: "" },
  { n: "03", title: "To be announced", when: "" },
];
---

<Layout
  title="unexpected detail, a podcast hosted by Marcy"
  description="Good questions. Great detours. A conversation podcast hosted by Marcy. First episode December 2026."
>
  <main id="main" class="site home">
    <!-- 1. Opening: dark, the line draws in and one falls -->
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-lines" aria-hidden="true">
        {
          strokes.map((s, i) => (
            <span class:list={{ fall: i + 1 === heroFall }} style={`--h:${s.h};--d:${s.d}s`} />
          ))
        }
      </div>
      <div class="hero-foot wrap">
        <h1 id="hero-h" class="hero-h">
          <span>Good questions.</span>
          <span>Great detours.</span>
        </h1>
        <p class="hero-sub">Come for the person. Stay for the detour.</p>
      </div>
    </section>

    <!-- 2. The flip -->
    <section class="frame" id="frame" aria-labelledby="frame-h">
      <div class="wrap frame-grid">
        <h2 id="frame-h" class="frame-h">Curiosity flips the frame.</h2>
        <p class="frame-note">
          We know what people do, what they’ve won, and what they’re supposed to sell next. This show is
          about everything else: the detours, the half-formed ideas, the quiet obsessions.
        </p>
      </div>
    </section>

    <!-- 3. The energy: sticky heading, traits pass on the right -->
    <section class="energy" aria-labelledby="energy-h">
      <div class="wrap energy-grid">
        <div class="energy-pin">
          <h2 id="energy-h" class="big">
            <span>Smart. Warm.</span>
            <span>A little offbeat.</span>
          </h2>
          <p class="note">Thoughtfully produced without feeling produced. Fun without feeling forced.</p>
        </div>
        <ol class="traits">
          {
            traits.map((t) => (
              <li class="trait">
                <h3>{t.t}</h3>
                <p>{t.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 4. The bio, struck through until the detail is left -->
    <section class="bio" aria-labelledby="bio-h">
      <div class="wrap">
        <h2 id="bio-h" class="big bio-h">
          <span>The best stories</span>
          <span>never make the bio.</span>
        </h2>
        <div class="bio-grid">
          <figure class="bio-photo">
            <img src="/marcy.webp" width="944" height="1108" alt="Marcy, smiling, in the driver’s seat of her car" loading="lazy" />
            <figcaption>Hosted by Marcy</figcaption>
          </figure>
          <div class="bio-lines" id="bio-lines">
            <ul aria-label="Marcy’s bio">
              {bio.map((b) => <li class="struck"><span>{b}</span></li>)}
            </ul>
            <p class="bio-detail">
              Once pulled onto a runway as a last‑minute model<span class="bio-dot" aria-hidden="true"></span>
            </p>
            <p class="note">
              What stayed with Marcy wasn’t the credits. It was the side conversations, the stories people
              tell once the formal part is over. This show brings them into the open.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. The handoff -->
    <section class="handoff" aria-labelledby="handoff-h">
      <div class="wrap">
        <h2 id="handoff-h" class="big handoff-h">
          <span>Every guest leaves a question</span>
          <span>for the next.</span>
        </h2>
        <ol class="chain" id="chain">
          {
            handoff.map((h, i) => (
              <li>
                <span class="chain-stop" aria-hidden="true" />
                <p class="chain-k">{h.k}</p>
                <p class="chain-b">{h.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Episodes (placeholder until the first one is out) -->
    <section class="episodes" aria-labelledby="ep-h">
      <div class="wrap ep-grid">
        <div>
          <h2 id="ep-h" class="big">Episodes</h2>
          <p class="note">
            New conversations on Apple Podcasts, Spotify and YouTube. The list fills in from December.
          </p>
        </div>
        <ol class="ep-list">
          {
            episodes.map((e, i) => (
              <li class:list={["ep", { "ep--later": i > 0 }]}>
                <span class="num ep-n">{e.n}</span>
                <span class="ep-title">{e.title}</span>
                <span class="ep-when">{e.when}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 7. Yours -->
    <section class="yours" id="join" aria-labelledby="yours-h">
      <div class="wrap">
        <h2 id="yours-h" class="yours-h">
          <span>Everyone has one.</span>
          <span>What’s yours?</span>
        </h2>
        <div class="yours-row">
          <form class="sub" data-proto>
            <label class="field">
              <span>Hear the first episode the day it’s out</span>
              <div class="sub-row">
                <input type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
                <button class="btn-ink" type="submit">Count me in</button>
              </div>
            </label>
            <p class="done" role="status" hidden>You’re on the list. See you in December.</p>
            <p class="proto">Preview: this form doesn’t send anything yet.</p>
          </form>
          <p class="note yours-note">
            Or send us your unexpected detail, or a question you’d love to hear a guest answer.
            <a class="go" href="/contact">Share yours <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<script>
  const root = document.documentElement;
  root.classList.add("js");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --flip: 0 (dark) to 1 (light) while the frame headline crosses the
  // middle of the screen. The page scrolls freely the whole time.
  const frame = document.getElementById("frame")!;
  let ticking = false;
  const update = () => {
    ticking = false;
    const top = frame.getBoundingClientRect().top;
    const t = Math.min(1, Math.max(0, (innerHeight * 0.75 - top) / (innerHeight * 0.45)));
    const s = t * t * (3 - 2 * t);
    root.style.setProperty("--flip", (s * s * (3 - 2 * s)).toFixed(3));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  update();

  // The trait nearest the middle of the screen is the one in focus.
  const traits = [...document.querySelectorAll<HTMLElement>(".trait")];
  const traitIo = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          traits.forEach((t) => t.classList.toggle("is-on", t === e.target));
        }
      }),
    { rootMargin: "-45% 0px -45% 0px" },
  );
  traits.forEach((t) => traitIo.observe(t));

  // One-shot states: the bio strikes through, the handoff line draws.
  const once = (el: Element | null, margin = "-30%") => {
    if (!el) return;
    if (reduce) return el.classList.add("is-in");
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          el.classList.add("is-in");
          io.disconnect();
        }
      },
      { rootMargin: `0px 0px ${margin} 0px` },
    );
    io.observe(el);
  };
  once(document.getElementById("bio-lines"));
  once(document.getElementById("chain"), "-20%");

  // Prototype form: confirm on screen, send nothing.
  document.querySelectorAll<HTMLFormElement>("form[data-proto]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.querySelector<HTMLElement>(".done")!.hidden = false;
      form.reset();
    }),
  );
</script>

<style is:global>
  /* The flip mixes every ground, ink and dot by --flip. Without the
     script, the opening is dark by its own background and the rest light. */
  :root:has(.site.home) {
    --flip: 0;
    --pct: calc(var(--flip) * 100%);
    --bg: color-mix(in srgb, var(--ud-paper) var(--pct), var(--ud-charcoal));
    --fg: color-mix(in srgb, var(--ud-ink) var(--pct), var(--ud-paper));
    --dot: color-mix(in srgb, var(--ud-mustard) var(--pct), var(--ud-butter));
    --nav-dot: var(--dot);
  }
  :root:has(.site.home):not(.js) {
    --flip: 1;
  }
  :root:not(.js) .home .hero {
    --bg: var(--ud-charcoal);
    --fg: var(--ud-paper);
    background: var(--bg);
    color: var(--fg);
  }

  .home .big {
    font-size: clamp(34px, 4.4vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 300;
  }
  .home .big > span,
  .home .hero-h > span,
  .home .yours-h > span {
    display: block;
  }

  /* ---------- 1. opening ---------- */
  .home .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-height));
    display: grid;
    grid-template-rows: 1fr auto;
    padding-bottom: clamp(32px, 5vw, 72px);
  }
  .home .hero-lines {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: clamp(24px, 5vh, 64px) var(--gutter) clamp(40px, 7vh, 96px);
  }
  .home .hero-lines span {
    width: 1px;
    height: clamp(160px, 34vh, 400px);
    background: currentColor;
    transform-origin: 50% 100%;
  }
  .home .hero-lines .fall {
    transform: rotate(14deg);
  }
  /* The waveform settles into an even row; then the one line tips over. */
  .js .home .hero-lines span {
    animation: ud-wave 1.5s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
  }
  .js .home .hero-lines .fall {
    animation:
      ud-wave 1.5s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both,
      ud-tip 1.1s cubic-bezier(0.55, 0, 0.25, 1) 2.1s both;
  }
  @keyframes ud-wave {
    0% {
      transform: scaleY(0);
    }
    45% {
      transform: scaleY(var(--h));
    }
    100% {
      transform: scaleY(1);
    }
  }
  @keyframes ud-tip {
    0% {
      rotate: 0deg;
    }
    70% {
      rotate: 15.5deg;
    }
    100% {
      rotate: 14deg;
    }
  }
  .js .home .hero-lines .fall {
    transform: none;
  }
  .home .hero-foot {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .home .hero-h {
    font-size: clamp(44px, 7.2vw, 120px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 300;
  }
  .home .hero-sub {
    padding-bottom: 0.6em;
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--muted);
  }
  /* The words arrive once the row has settled. */
  .js .home .hero-h > span,
  .js .home .hero-sub {
    animation: ud-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 1.2s;
  }
  .js .home .hero-h > span:nth-child(2) {
    animation-delay: 1.32s;
  }
  .js .home .hero-sub {
    animation-delay: 1.5s;
  }
  @keyframes ud-rise {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.3em);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 -0.2em 0);
      transform: none;
    }
  }

  /* ---------- 2. the flip ---------- */
  .home .frame {
    padding-block: clamp(120px, 22vh, 240px) clamp(120px, 18vw, 240px);
  }
  .home .frame-grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .home .frame-h {
    font-size: clamp(48px, 8.4vw, 144px);
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: 10ch;
  }
  .home .frame-note {
    justify-self: end;
    max-width: 40ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- 3. energy: pinned heading ---------- */
  .home .energy {
    padding-bottom: clamp(80px, 12vw, 160px);
  }
  .home .energy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .home .energy-pin {
    position: sticky;
    top: calc(var(--nav-height) + clamp(48px, 10vh, 120px));
  }
  .home .energy-pin .note {
    margin-top: 24px;
  }
  .home .traits {
    border-top: 1px solid var(--rule);
  }
  .home .trait {
    min-height: 42vh;
    padding-block: 28px clamp(48px, 10vh, 96px);
    border-bottom: 1px solid var(--rule);
    opacity: 0.4;
    transition: opacity 0.5s var(--ease);
  }
  .home .trait.is-on,
  :root:not(.js) .home .trait {
    opacity: 1;
  }
  .home .trait h3 {
    font-size: clamp(24px, 2.4vw, 36px);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .home .trait p {
    margin-top: 12px;
    max-width: 34ch;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- 4. the bio ---------- */
  .home .bio {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 1px solid var(--rule);
  }
  .home .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px clamp(40px, 7vw, 128px);
    align-items: end;
    margin-top: clamp(56px, 8vw, 112px);
  }
  .home .bio-photo {
    max-width: 460px;
  }
  .home .bio-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 944 / 1108;
    object-fit: cover;
  }
  .home .bio-photo figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .home .bio-lines li {
    padding-block: 12px;
    font-size: clamp(22px, 2.2vw, 34px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .home .struck span {
    position: relative;
    transition: color 0.6s var(--ease);
  }
  .home .struck span::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    top: 55%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .home .is-in .struck span {
    color: var(--muted);
  }
  .home .is-in .struck span::after,
  :root:not(.js) .home .struck span::after {
    transform: none;
  }
  .home .is-in .struck:nth-child(2) span,
  .home .is-in .struck:nth-child(2) span::after {
    transition-delay: 0.35s;
  }
  .home .is-in .struck:nth-child(3) span,
  .home .is-in .struck:nth-child(3) span::after {
    transition-delay: 0.7s;
  }
  .home .bio-detail {
    margin-top: 32px;
    font-size: clamp(30px, 3.6vw, 56px);
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 16ch;
  }
  .home .bio-dot {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.08em;
    border-radius: 50%;
    background: var(--dot);
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.3s;
  }
  .home .is-in .bio-dot,
  :root:not(.js) .home .bio-dot {
    transform: none;
  }
  .home .bio-lines .note {
    margin-top: 32px;
  }

  /* ---------- 5. the handoff ---------- */
  .home .handoff {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 1px solid var(--rule);
  }
  .home .handoff-h {
    max-width: none;
  }
  .home .chain {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(64px, 9vw, 128px);
    padding-top: 40px;
  }
  /* The line the question travels along, and the question itself. */
  .home .chain::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .home .chain::after {
    content: "";
    position: absolute;
    top: -6px;
    left: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--dot);
    transition: left 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .home .chain.is-in::before,
  :root:not(.js) .home .chain::before {
    transform: none;
  }
  .home .chain.is-in::after,
  :root:not(.js) .home .chain::after {
    left: calc(100% - 13px);
  }
  .home .chain-stop {
    position: absolute;
    top: -4px;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--fg);
  }
  .home .chain li {
    position: relative;
  }
  .home .chain li .chain-stop {
    top: -44px;
    left: 0;
  }
  .home .chain-k {
    font-size: clamp(20px, 1.7vw, 26px);
    letter-spacing: -0.02em;
  }
  .home .chain-b {
    margin-top: 10px;
    max-width: 30ch;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- 6. episodes ---------- */
  .home .episodes {
    padding-block: clamp(96px, 14vw, 200px);
    border-top: 1px solid var(--rule);
  }
  .home .ep-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 48px clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .home .ep-grid .note {
    margin-top: 24px;
  }
  .home .ep-list {
    border-top: 1px solid var(--fg);
  }
  .home .ep {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding-block: 26px;
    border-bottom: 1px solid var(--rule);
  }
  .home .ep-n {
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .home .ep-title {
    font-size: clamp(19px, 1.6vw, 24px);
    letter-spacing: -0.02em;
  }
  .home .ep-when {
    font-size: 14px;
    color: var(--muted);
  }
  .home .ep--later {
    color: var(--muted);
  }

  /* ---------- 7. yours ---------- */
  .home .yours {
    padding-block: clamp(96px, 14vw, 200px) clamp(80px, 10vw, 144px);
    border-top: 1px solid var(--rule);
  }
  .home .yours-h {
    font-size: clamp(40px, 8.4vw, 144px);
    line-height: 0.96;
    letter-spacing: -0.04em;
    font-weight: 300;
  }
  .home .yours-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(40px, 6vw, 112px);
    align-items: end;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .home .sub {
    display: grid;
    gap: 14px;
    max-width: 520px;
  }
  .home .sub-row {
    display: flex;
    gap: 12px;
