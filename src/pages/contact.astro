---
/*
  Contact: one quiet page in the site's system (src/styles/site.css). A
  short, warm hello on the left; on the right, a choice of what the note is
  about, set as a ruled list (the selected one takes the dot, Mustard, the
  one place yellow appears on the page), then name, email and the note
  itself, whose label follows the choice.

  The form is a prototype: it checks the fields, thanks the sender on
  screen and sends nothing until a form service is chosen. No email address
  is shown yet; Marcy's is still to come. The social handle and where to
  listen are in the footer.
*/
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

// What the note is about. Each choice gives the message field its own
// label and a nudge to start from.
const kinds = [
  { value: "detail", label: "Sharing my unexpected detail", field: "Your unexpected detail", hint: "I once…" },
  { value: "question", label: "A question for a future guest", field: "Your question", hint: "I’ve always wanted to ask…" },
  { value: "guest", label: "I’d like to be a guest", field: "A little about you", hint: "What you’d love to talk about, and where to find you" },
  { value: "hello", label: "Just saying hello", field: "Your note", hint: "Hi Marcy…" },
  { value: "other", label: "Something else", field: "Your note", hint: "" },
];
const first = kinds[0];
---

<Layout
  title="Contact, unexpected detail"
  description="Have a story, a question, or something we should be talking about? Write to Unexpected Detail."
>
  <main id="main" class="site contact">
    <section class="contact-spread" aria-labelledby="contact-h">
      <div class="wrap contact-grid">
        <div class="contact-intro">
          <h1 id="contact-h" class="t-h1">Something on your mind?</h1>
          <p class="t-l intro-lead">
            Have a story, a question, or something we should be talking about? We’d love to hear it.
          </p>
          <p class="intro-aside">A guest idea is welcome, too. Or just say hello.</p>
        </div>

        <div class="contact-side">
          <form class="contact-form" data-proto novalidate>
            <fieldset class="kinds">
              <legend>What’s it about?</legend>
              <ul>
                {
                  kinds.map((k) => (
                    <li>
                      <label class="kind">
                        <input type="radio" name="kind" value={k.value} checked={k === first} data-field={k.field} data-hint={k.hint} />
                        <span class="kind-dot" aria-hidden="true" />
                        <span class="kind-label">{k.label}</span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            </fieldset>

            <div class="pair">
              <label class="field">
                <span>Name</span>
                <input type="text" name="name" autocomplete="name" required aria-describedby="name-err" />
                <em class="err" id="name-err">So we know who to thank.</em>
              </label>
              <label class="field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="email" required aria-describedby="email-err" />
                <em class="err" id="email-err">So we can write back.</em>
              </label>
            </div>

            <label class="field">
              <span id="msg-label">{first.field}</span>
              <textarea name="message" rows="4" placeholder={first.hint} required aria-describedby="msg-err"></textarea>
              <em class="err" id="msg-err">A line or two is plenty.</em>
            </label>

            <div class="send">
              <button class="btn-ink" type="submit">Send</button>
              <p class="proto">Preview: this form doesn’t send anything yet.</p>
            </div>
          </form>

          <div class="thanks" role="status" tabindex="-1" hidden>
            <p class="t-h3">Thank you.</p>
            <p class="t-l thanks-b">We’re glad you wrote.</p>
            <button class="go again" type="button">Write another <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </div>
    </section>
    <SiteFooter />
  </main>
</Layout>

<script>
  document.documentElement.classList.add("js");
  const form = document.querySelector<HTMLFormElement>(".contact-form")!;
  const thanks = document.querySelector<HTMLElement>(".thanks")!;
  const label = document.getElementById("msg-label")!;
  const message = form.querySelector<HTMLTextAreaElement>("textarea")!;
  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea")];

  // The message field follows the choice.
  form.querySelectorAll<HTMLInputElement>("input[name=kind]").forEach((r) =>
    r.addEventListener("change", () => {
      label.textContent = r.dataset.field || "Your note";
      message.placeholder = r.dataset.hint || "";
    }),
  );

  // A field is only marked once someone has tried to send, then it clears
  // as soon as it's right.
  const check = (f: HTMLInputElement | HTMLTextAreaElement) => {
    const bad = !f.value.trim() || !f.checkValidity();
    f.toggleAttribute("aria-invalid", bad);
    return !bad;
  };
  fields.forEach((f) =>
    f.addEventListener("input", () => {
      if (f.hasAttribute("aria-invalid")) check(f);
    }),
  );

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const bad = fields.filter((f) => !check(f));
    if (bad.length) {
      bad[0].focus();
      return;
    }
    // Prototype: confirm on screen, send nothing.
    form.hidden = true;
    thanks.hidden = false;
    thanks.focus();
  });

  thanks.querySelector(".again")!.addEventListener("click", () => {
    form.reset();
    form.querySelector<HTMLInputElement>("input[name=kind]:checked")!.dispatchEvent(new Event("change"));
    thanks.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>("input[name=kind]:checked")!.focus();
  });
</script>

<style>
  .contact-spread {
    min-height: calc(100svh - var(--nav-height) - 80px);
    padding-block: clamp(56px, 9vw, 144px) clamp(96px, 12vw, 176px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 72px clamp(48px, 8vw, 144px);
    align-items: start;
  }

  /* ---------- the hello ---------- */
  .contact-intro {
    position: sticky;
    top: calc(var(--nav-height) + clamp(40px, 7vw, 96px));
  }
  .contact-intro h1 {
    max-width: 9ch;
  }
  .intro-lead {
    margin-top: clamp(28px, 3vw, 40px);
    max-width: 30ch;
  }
  .intro-aside {
    margin-top: 16px;
    max-width: 34ch;
    color: var(--muted);
  }

  /* ---------- the form ---------- */
  .contact-form {
    display: grid;
    gap: 28px;
  }
  .kinds {
    margin-bottom: 20px;
  }
  fieldset.kinds {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .contact legend,
  .contact .field > span {
    padding: 0;
    font-size: var(--t-s);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
  }
  .kinds ul {
    margin-top: 12px;
    border-top: 1px solid var(--rule);
  }
  .kind {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
  }
  .kind input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  /* A ring; chosen, it fills with the dot. */
  .kind-dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--fg) 40%, transparent);
    background: radial-gradient(circle, var(--ud-mustard) 0 4px, transparent 4.5px) center / 0 0 no-repeat;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-size var(--duration-fast) var(--ease-emphasized);
  }
  .kind-label {
    font-size: var(--t-l);
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .kind:hover .kind-label,
  .kind input:checked ~ .kind-label {
    color: var(--fg);
  }
  .kind input:checked + .kind-dot {
    border-color: var(--fg);
    background-size: 100% 100%;
  }
  .kind input:focus-visible + .kind-dot {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 32px;
  }
  /* The note under each field keeps its line even when empty, so marking
     a field never shifts the form. */
  .contact .field {
    gap: 4px;
  }
  .contact textarea {
    min-height: 6em;
    field-sizing: content;
    resize: none;
  }
  .contact .err {
    font-style: normal;
    font-size: var(--t-s);
    color: var(--fg);
    visibility: hidden;
  }
  .contact [aria-invalid] {
    border-bottom-color: var(--fg);
  }
  .contact [aria-invalid] ~ .err {
    visibility: visible;
  }

  .send {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  /* ---------- after sending ---------- */
  .contact-form[hidden],
  .thanks[hidden] {
    display: none;
  }
  .thanks {
    padding-top: clamp(8px, 2vw, 24px);
    animation: ud-thanks 0.6s var(--ease-emphasized) both;
  }
  .thanks:focus {
    outline: none;
  }
  .thanks-b {
    margin-top: 12px;
    color: var(--muted);
  }
  .thanks .again {
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    padding: 0 0 4px;
    color: inherit;
    font: inherit;
    font-size: 15px;
    font-weight: 400;
    cursor: pointer;
  }
  @keyframes ud-thanks {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .contact-grid,
    .pair {
      grid-template-columns: 1fr;
    }
    .contact-intro {
      position: static;
    }
  }
</style>
