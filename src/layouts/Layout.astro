---
/*
  The page shell for the unexpected detail site. Trimmed from the portfolio's
  layout: the same tokens, global styles, Geist, the nav and smooth
  scrolling, without the portfolio's analytics, schema or theme switching.
  Pages are noindex while the site is private and on every preview
  (src/data/environment.ts), or when a page asks for it.
*/
interface Props {
  title: string;
  description?: string;
  /** Keep this page out of search even once the site is public. */
  noindex?: boolean;
  /** Kept for the same reason; the site is always light. */
  theme?: "light";
}

import { tokensToCss } from "../data/tokens";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { BLOCK_INDEXING } from "../data/environment";

// Every token as a custom property on :root, in place before the first paint.
const tokenCss = tokensToCss();
const { title, description = "The brand identity for the unexpected detail podcast.", noindex = false } = Astro.props;
const robots = BLOCK_INDEXING || noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-pinned="">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:inline set:html={tokenCss} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <slot />
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      // Smooth scrolling, except for anyone who has asked for less motion.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ lerp: 0.15, smoothWheel: true });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
